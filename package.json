{
  "name": "bon-voyage",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "python -m uvicorn backend.main:app --host 0.0.0.0 --port 8000",
    "test": "python -m unittest discover -s backend -p test_*.py",
    "test:frontend": "node --test src/*.test.js",
    "test:browser": "node tests/browser-races.cjs",
    "test:intro": "node tests/browser-intro.cjs",
    "test:planner": "node tests/browser-planner.cjs",
    "test:dialogs": "node tests/browser-dialogs.cjs",
    "test:search": "node tests/browser-search.cjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "vite": "^7.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.64.1"
  }
}
